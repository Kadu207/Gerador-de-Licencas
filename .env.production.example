# Copie para .env na VPS: /opt/gerador-licencas/.env
# Domínio: https://licencas.inovatitech.com.br
#
# OBRIGATÓRIO: POSTGRES_APP_PASSWORD (senha do banco Docker license-db)

LICENSE_SERVER_HOST=0.0.0.0
LICENSE_SERVER_PORT=8195
TRUST_PROXY=true
PUBLIC_BASE_URL=https://licencas.inovatitech.com.br

SECRET_KEY=GERE-SECRET-FORTE-MIN-64-CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TROQUE-SENHA-FORTE-ADMIN

# Postgres dedicado (container license-db) — OBRIGATÓRIO
POSTGRES_APP_PASSWORD=TROQUE-SENHA-POSTGRES-FORTE

# Não defina LOCAL_DATABASE_URL aqui em produção Docker — o entrypoint monta com host license-db.
# LOCAL_DATABASE_URL=   # deixe comentado ou remova

# Chave compartilhada com Dental Lab (header X-License-Api-Key)
PRODUCT_API_KEY=GERE-CHAVE-API-PRODUTOS-FORTE

LAB_AUTO_TRIAL_DAYS=30
BLOCK_AFTER_DAYS=30
CANCEL_AFTER_DAYS=45

SYNC_REMOTE_ENABLED=false

# Servidor Gerenciador de Licenças — InovatiTech
LICENSE_SERVER_HOST=127.0.0.1
LICENSE_SERVER_PORT=8195

# Produção (VPS + nginx + Cloudflare)
# LICENSE_SERVER_HOST=0.0.0.0
# TRUST_PROXY=true
# PUBLIC_BASE_URL=https://licencas.inovatitech.com.br

SECRET_KEY=troque-por-chave-forte-min-32-chars

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Troque@Senha2026!

# Banco local (dev) ou Postgres dedicado (produção)
LOCAL_DATABASE_URL=sqlite:///./data/gerador_licencas.db
# LOCAL_DATABASE_URL=postgresql+psycopg://licencas:SENHA@127.0.0.1:5433/licencas_db
POSTGRES_PASSWORD=licencas_dev_change_me

# Sync remoto — desligado por padrão (API é fonte da verdade)
SYNC_REMOTE_ENABLED=false
ERP_DATABASE_URL=
LAB_DATABASE_URL=
LAB_SCHEMA=dental_lab

PRODUCT_API_KEY=troque-por-chave-api-produtos

BLOCK_AFTER_DAYS=30
CANCEL_AFTER_DAYS=45
LAB_AUTO_TRIAL_DAYS=30

# Email alertas
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=licencas@inovatitech.com.br

# Stripe (Restricted Key recomendada)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# NFS-e prefeitura (preencher quando disponível)
NFSE_ENABLED=false
NFSE_API_URL=
NFSE_CERT_PATH=
NFSE_SERVICE_CODE=

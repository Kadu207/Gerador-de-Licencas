# Servidor Gerenciador de Licenças — InovatiTech
LICENSE_SERVER_HOST=127.0.0.1
LICENSE_SERVER_PORT=8195

SECRET_KEY=troque-por-chave-forte-min-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-senha-admin-forte

# Postgres dedicado (Docker license-db na porta 5433)
# Superusuário postgres — variável POSTGRES_SUPER_PASSWORD
# Usuário app licencas — variável POSTGRES_APP_PASSWORD
# Docker Compose: $$ = um $ literal no .env
POSTGRES_SUPER_PASSWORD=defina-super-senha-postgres
POSTGRES_APP_PASSWORD=defina-senha-usuario-licencas
# URL: senha com $ deve usar %24 no lugar do $
LOCAL_DATABASE_URL=postgresql+psycopg://licencas:SENHA_URL_ENCODED@127.0.0.1:5436/licencas_db

SYNC_REMOTE_ENABLED=false
ERP_DATABASE_URL=
LAB_DATABASE_URL=
LAB_SCHEMA=dental_lab

PRODUCT_API_KEY=troque-por-chave-api-produtos
BLOCK_AFTER_DAYS=30
CANCEL_AFTER_DAYS=45

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=licencas@inovatitech.com.br

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NFSE_ENABLED=false
NFSE_API_URL=
NFSE_CERT_PATH=
NFSE_SERVICE_CODE=
